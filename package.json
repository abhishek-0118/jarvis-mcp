{
  "name": "@anthropic/jarvis-mcp",
  "version": "0.1.0",
  "description": "Jarvis MCP server — connect Cursor (or any MCP client) to the Jarvis code-intelligence engine",
  "type": "module",
  "bin": {
    "jarvis-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "start:sse": "node dist/sse-server.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "jarvis",
    "cursor",
    "code-intelligence",
    "rag",
    "codebase-search"
  ],
  "author": "Orange Health <abhishek.gupta@orangehealth.in>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orange-Health/jarvis-mcp.git"
  },
  "homepage": "https://github.com/Orange-Health/jarvis-mcp#readme",
  "bugs": {
    "url": "https://github.com/Orange-Health/jarvis-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chokidar": "^4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
